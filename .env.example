# No guardes secretos en el frontend ni en Git.
# Lista separada por comas de dominios personalizados que uses además de *.github.io.
ALLOWED_ORIGINS=https://tu-dominio.example

# Opcional: recuperación por correo (Resend). Sin estas variables, el sistema no simula envíos.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=MUSIC PLAYER <cuentas@tu-dominio.example>
PUBLIC_APP_URL=https://usuario.github.io/repositorio/
